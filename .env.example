# Copy to .env and fill in. Never commit .env.

APP_ENV=development                 # production enables secure cookies and refuses console email
APP_URL=http://localhost:8000       # public URL of this app (used for the Zoho OAuth redirect)
PORT=8000
RUN_WORKER_INLINE=true              # run the background worker inside the web process (simple setups)

# Supabase → Project settings → API. The service-role key stays on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secrets for this app. Generate with: deno task keygen  (run twice, one per line)
ENCRYPTION_KEY=                     # 32-byte base64 — encrypts Zoho tokens at rest
HASH_PEPPER=                        # any long random string — keys the OTP / confirmation hashes

# Zoho "Server-based Application" client (api-console.zoho.com) for the Connect-with-Zoho button.
# Authorized redirect URI must be: ${APP_URL}/api/zoho/callback
# Leave empty to use only the per-enterprise Self Client option in Settings.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_REDIRECT_URI=http://localhost:8000/api/zoho/callback
# ZOHO_SCOPES=MDMOnDemand.MDMInventory.ALL,MDMOnDemand.MDMDeviceMgmt.ALL,MDMOnDemand.MDMUser.ALL

# Email for OTP + wipe confirmation codes.
#   console   = print codes in the terminal (development only)
#   zeptomail = Zoho ZeptoMail (recommended — same Zoho ecosystem)
#   resend    = Resend
MAIL_PROVIDER=console
# ZeptoMail → Mail Agents → SMTP/API → Send Mail token
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_URL=https://zeptomail.zoho.com/v1.1/email   (Zoho EU/IN accounts: zeptomail.zoho.eu / zeptomail.zoho.in)
RESEND_API_KEY=
# MAIL_FROM must use a domain you verified in ZeptoMail
MAIL_FROM="MDM Console <no-reply@yourdomain.co.tz>"

# Tuning (defaults shown)
# SESSION_TTL_HOURS=12
# OTP_TTL_MINUTES=10
# CONFIRM_TTL_MINUTES=10
# WORKER_INTERVAL_SECONDS=15
# SYNC_INTERVAL_MINUTES=15
